# =====================================================================
# Marrai Backend environment
# Copy to `.env` for docker compose, or export in your shell / platform UI.
# Never commit real credentials.
# =====================================================================

# Environment: development | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional file log sink. Leave empty to log to stdout/stderr only
# (recommended for containers).
LOG_FILE=

# ---------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------
# Public origin of the Next.js frontend. Used to build shareable report
# links in emails and as the default CORS origin.
FRONTEND_URL=http://localhost:3000
# Comma-separated extra CORS origins (e.g. https://marrai.tech)
CORS_ORIGINS=

# ---------------------------------------------------------------------
# PostgreSQL - two supported styles
# ---------------------------------------------------------------------
# Preferred: direct URL from a hosted provider (Render/Railway/Neon/...).
# If empty, the individual DB_* variables are used.
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=aeo_audit
DB_USER=postgres
DB_PASSWORD=postgres

# ---------------------------------------------------------------------
# Redis (broker for Celery + rate limiting)
# ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# Crawler
# ---------------------------------------------------------------------
# Maximum number of pages fetched per audit.
CRAWL_LIMIT=20
# Per-request read timeout (seconds).
CRAWL_TIMEOUT=10
# TCP connect timeout (seconds).
CRAWL_CONNECT_TIMEOUT=5.0
# Maximum total time for one page request including redirects.
CRAWL_TOTAL_TIMEOUT=30.0
# Maximum redirect hops followed per URL.
CRAWL_MAX_REDIRECTS=5
# Maximum HTML response body size (bytes) - 2 MB default.
CRAWL_MAX_BODY_BYTES=2000000
# Concurrent pages fetched at once.
CRAWL_CONCURRENCY=3
USER_AGENT=marrai-aeo-audit/1.0

# ---------------------------------------------------------------------
# Scoring / worker
# ---------------------------------------------------------------------
# sentence-transformers model id.
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Celery worker concurrency (workers per container).
#   docker compose uses: celery -A app.worker.celery_app worker --concurrency=$WORKER_CONCURRENCY_LIMIT
WORKER_CONCURRENCY_LIMIT=2
# Hard time limits for a single audit task.
TASK_TIME_LIMIT=300
TASK_SOFT_TIME_LIMIT=240

# ---------------------------------------------------------------------
# Rate limiting (audit creation per client IP per window).
# A token: 5 audits / hour is generous for real users and stops scripts.
# ---------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_REQUESTS=5

# ---------------------------------------------------------------------
# Optional completion email (Resend). Empty API key disables email.
# ---------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Marrai <no-reply@example.com>

# ---------------------------------------------------------------------
# Frontend proxy trust boundary (IMPORTANT in production)
# ---------------------------------------------------------------------
# Shared secret the Next.js server routes send as X-Proxy-Secret to prove
# they are the real frontend and to vouch for the X-Client-IP header.
# When set, direct API calls without the secret are rejected (403).
# Generate with: openssl rand -hex 32
# Leave empty only for local development.
API_PROXY_SHARED_SECRET=